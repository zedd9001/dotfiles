{
  "layer": "bottom",
  "position": "bottom",
  "height": 34,
  "spacing": 4,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": [],
  "modules-right": ["battery", "custom/ethernet", "custom/localip", "clock#date", "clock#time"],
  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "sort-by": "number",
    "format": "{name}"
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 50,
    "tooltip": false
  },
  "battery": {
    "bat": "BAT0",
    "adapter": "ADP0",
    "interval": 30,
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-charging": "{icon} {capacity}% ({time} to full)",
    "format-plugged": "{icon} {capacity}% (plugged in)",
    "format-full": "{icon} {capacity}% (full)",
    "format-discharging": "{icon} {capacity}% ({time} left)",
    "format-time": "{H}h {M}m",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip": true
  },
  "custom/ethernet": {
    "exec": "if grep -lq up /sys/class/net/en*/operstate 2>/dev/null; then echo '󰈁 Ethernet: Connected'; else echo '󰈂 Ethernet: Disconnected'; fi",
    "interval": 5,
    "return-type": "text",
    "format": "{}",
    "tooltip": false
  },
  "custom/localip": {
    "exec": "ip -4 addr show scope global up | grep inet | awk '{print $2}' | cut -d/ -f1 | head -1 | sed 's/^/󰯄 /'",
    "interval": 10,
    "tooltip": false
  },
  "clock#date": {
    "format": "󰃭 {:%a %d %b} ",
    "tooltip": false,
    "interval": 60
  },
  "clock#time": {
    "format": "󰥔 {:%I:%M %p} ",
    "tooltip": false,
    "interval": 30
  }
}